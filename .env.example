# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- LLM Provider ---
# "anthropic" (default): uses Claude Haiku, requires ANTHROPIC_API_KEY
# "github": uses GitHub Models (gpt-4o-mini, free), requires GITHUB_TOKEN
LLM_PROVIDER=github

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- GitHub Models ---
# Get your token at: https://github.com/settings/tokens
# Required scope: (none — a classic token with no scope works for GitHub Models)
GITHUB_TOKEN=your_github_token_here
